{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npm install",
  "buildCommand": "cd ../.. && npx turbo run build --filter=api",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/health" },
    { "source": "/(.*)", "destination": "/api" }
  ]
}
