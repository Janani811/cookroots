# Cookroots API Environment Variables
# Copy this file to .env and fill in your actual values

# Database Configuration
# Discrete Postgres credentials used to build the connection pool
# (see packages/db/src/config/database.config.ts). SSL is enabled
# automatically when NODE_ENV=production.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cookroots
DB_USER=postgres
DB_PASSWORD=password

# Gemini Configuration
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Server Configuration
# Port the API server runs on
PORT=4000

# Node Environment
# Options: development, production, staging
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
# For development: http://localhost:3000,http://localhost:3001
# For production: https://example.com,https://www.example.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# JWT Configuration (for token-based auth - optional)
# JWT_SECRET=your-super-secret-key
# JWT_EXPIRES_IN=7d

# Resend Configuration (for password reset emails - optional)
# Without this set, password reset falls back to dev mode: the reset link
# is returned directly in the API response instead of being emailed.
# Get a free API key at https://resend.com
# RESEND_API_KEY=your-resend-api-key
# EMAIL_FROM=onboarding@resend.dev

# Web app base URL (used to build password reset links)
WEB_URL=http://localhost:3000

# Cloudinary Configuration (for image uploads)
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Logging Configuration (optional)
# LOG_LEVEL=debug
# LOG_FORMAT=json

# Rate Limiting (optional)
# RATE_LIMIT_WINDOW=15
# RATE_LIMIT_MAX_REQUESTS=100
