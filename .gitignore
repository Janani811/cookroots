# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Apps also have their own .gitignore for framework-specific rules (Expo, Next.js, Nest).

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Env files
.env
.env.local
.env.*.local
!.env.example

# Testing / coverage
coverage/
.nyc_output/

# Turborepo
.turbo/

# Vercel
.vercel

# Build outputs
.next/
out/
build/
dist/
web-build/
.expo/
.expo-shared/

# Native (Expo/React Native generated folders)
/apps/*/ios
/apps/*/android

# TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Root-level docs (kept locally, not tracked)
/*.md

# Editors / OS
.DS_Store
*.pem
.idea/
*.sublime-workspace

# VSCode (keep shared settings, ignore personal ones)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
