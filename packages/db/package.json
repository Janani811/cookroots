{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migration:generate": "drizzle-kit generate --config=src/config/migration.config.ts",
    "migration:push": "drizzle-kit push --config=src/config/migration.config.ts",
    "migration:drop": "drizzle-kit drop --config=src/config/migration.config.ts",
    "migration:run": "drizzle-kit migrate --config=src/config/migration.config.ts",
    "migration:studio": "drizzle-kit studio --config=src/config/migration.config.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/types": "*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.2",
    "gel": "^0.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.4",
    "typescript": "5.9.2"
  }
}
